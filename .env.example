# =============================================================================
# crypto-trading-bot — environment variables
#
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env to git (it is git-ignored).
#
# Only "trade-only" scoped API keys are ever permitted here — withdrawal
# permission must stay disabled. No key goes in any tracked file, ever.
#
# Mechanism: Freqtrade reads FREQTRADE__<SECTION>__<KEY> environment variables
# (double underscore = config nesting) and they override the corresponding
# values in user_data/config-*.json. Docker Compose injects them via env_file.
# =============================================================================

# --- Exchange API credentials (needed from Phase 5 backtest / Phase 9 live) ---
# Scope: "Spot Trading" ONLY. Withdrawal permission must stay disabled.
# Restrict to your machine's static IP if the exchange supports it.
FREQTRADE__EXCHANGE__KEY=your_exchange_api_key_here
FREQTRADE__EXCHANGE__SECRET=your_exchange_api_secret_here
# Optional: a few exchanges (e.g. Kraken) require an additional password/passphrase
#FREQTRADE__EXCHANGE__PASSWORD=

# --- Telegram remote control (Phase 7) ----------------------------------------
# One switch lights two surfaces: freqtrade's native RPC (send /status,
# /profit, /stop ... from your phone) and the watchdog's breach/error
# notifications to the same chat.
# Setup:
#   1. @BotFather -> /newbot -> keep the token it gives you.
#   2. Open a chat with your bot and press Start (Telegram requires it).
#   3. Find YOUR numeric chat id: message @userinfobot (it replies "Id"),
#      or send the bot a message and read getUpdates (stop the freqtrade
#      container first — its RPC consumes the same feed):
#      curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"id":[0-9]*'
#   4. Fill TOKEN and CHAT_ID below, set ENABLED=true, then:
#      docker compose up -d --force-recreate freqtrade watchdog
# The gate REFUSES ENABLED=true while these still hold the placeholder
# values (or a malformed token) — freqtrade would abort at startup on a
# bad token and restart-loop forever. Keep the placeholders verbatim; a
# test pins them against scripts/validate_config.py.
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=0000000000:AAExample_Token_Placeholder_Not_Real_000
FREQTRADE__TELEGRAM__CHAT_ID=000000000

# --- Freqtrade REST API server (Phase 2 config; port bound to 127.0.0.1 only) --
FREQTRADE__API_SERVER__USERNAME=freqtrade
FREQTRADE__API_SERVER__PASSWORD=change_me_use_a_long_random_password
# Random secrets for API session signing / websocket auth (FreqUI in Phase 7+).
# freqtrade requires >= 32 chars for both (short values crash `docker compose up`).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace_me_generate_with_secrets_token_urlsafe_32_chars_min_000000
FREQTRADE__API_SERVER__WS_TOKEN=replace_me_generate_with_secrets_token_urlsafe_32_chars_min_000000

# NEVER set any of these FREQTRADE__* variables in this file — the start-path
# validator REFUSES them (exit 1) because they would override the dry-run gate
# or the hardcoded risk limits at runtime, bypassing the file-based checks:
#   FREQTRADE__DRY_RUN, FREQTRADE__TRADING_MODE, FREQTRADE__MARGIN_MODE,
#   FREQTRADE__MAX_OPEN_TRADES, FREQTRADE__STAKE_AMOUNT,
#   FREQTRADE__TRADABLE_BALANCE_RATIO, FREQTRADE__DRY_RUN_WALLET
# Risk limits change only via reviewed commits to scripts/risk_guard.py.

# --- Live-trading safety gate (Phase 2 validator; Phase 9 go-live) -------------
# Must be set to exactly "yes" before starting with dry_run: false is accepted.
# Leave as "no" at all times unless deliberately going live (see
# docs/GOLIVE_CHECKLIST.md once it exists).
LIVE_TRADING_CONFIRMED=no
